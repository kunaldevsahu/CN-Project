# ---- Extension C: service isolation for Backend A (Mac 3, Himanshu, port 3001) ----
# Loaded into the pf sub-anchor "com.apple/team1" by firewall/fw-on.sh.
# /etc/pf.conf is NOT edited; fw-off.sh removes these rules and restores the original state.

edges        = "{ 10.7.21.121 }"   # Mac 2 primary edge. (The standby edge on Mac 3 reaches 3001 over lo0.)
backend_port = "3001"

# Traffic from this Mac to itself (lo0) is always allowed
pass in quick on lo0 all

# Only the edge may open TCP connections to the backend port
pass in quick proto tcp from $edges to any port $backend_port

# Everyone else is silently dropped (no RST), so a client sees a timeout, not "connection refused".
# "log" copies dropped packets to pflog0 for evidence: sudo tcpdump -n -e -i pflog0
block drop in log quick proto tcp from any to any port $backend_port
